# Copy to .env and fill in. .env is gitignored — never commit real values.
# Get these from DevTools > Application > Cookies > https://fantasy.espn.com
ESPN_S2=
SWID={00000000-0000-0000-0000-000000000000}
LEAGUE_ID=
SEASON=2026

# Roster moves (manage.py) are refused unless this is set. Everything still
# previews with it unset — only actually sending is blocked. Leave it off
# until you have read a preview and want that exact move to happen.
ESPN_WRITES=0
